# =============================================================================
# ImaginarIA — configuracion
# Copia este fichero a .env.local y rellena lo que necesites.
# Ninguna variable lleva el prefijo NEXT_PUBLIC_: nada de esto debe llegar al
# navegador.
# =============================================================================

# --- Proveedor de IA ---------------------------------------------------------
# "google" (Gemini via Google AI Studio) o "groq".
#
# Admite una CADENA separada por comas: "google,groq". El primero atiende; los
# siguientes solo entran si el anterior se queda sin cuota (429) o esta caido
# (5xx). Un proveedor sin su clave se omite en silencio, asi que anadir un
# respaldo es solo pegar una clave mas. Comprueba la cadena activa con
# GET /api/chat.
AI_PROVIDER=google

# Google AI Studio — https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=
# Verifica los ids disponibles en la consola: rotan con frecuencia.
GEMINI_MODEL=gemini-3.7-flash
# "low" | "high" | "default" (omite el campo). "low" prioriza latencia.
# Solo para modelos Gemini 3.x: los 2.5 usan thinkingBudget (ver provider.ts).
GEMINI_THINKING_LEVEL=low

# Groq — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Cerebras — https://cloud.cerebras.ai (API compatible con OpenAI)
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b

# --- Parametros de inferencia ------------------------------------------------
# Temperatura alta a proposito: el producto es divergencia creativa. Bajala a
# ~0.7 si notas que el modelo se va de los raíles.
AI_TEMPERATURE=1
AI_TOP_P=0.95
AI_MAX_OUTPUT_TOKENS=4000

# --- Langfuse (opcional) -----------------------------------------------------
# Si estas dos faltan, la aplicacion funciona igual y solo pierde las trazas.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# UE: https://cloud.langfuse.com | US: https://us.cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_ENVIRONMENT=development
# Prompt Management: DEJA ESTO VACIO salvo que hayas creado el prompt
# "imaginaria-system" en Langfuse. Con valor, el system prompt se sirve desde
# esa etiqueta y el del repositorio queda como fallback.
LANGFUSE_PROMPT_LABEL=

# --- Rate limiting -----------------------------------------------------------
# Por instancia y en memoria. Ver la nota en app/api/chat/route.ts.
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
